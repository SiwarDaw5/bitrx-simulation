# ── LLM ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Embeddings ─────────────────────────────────────────
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ── NTP ───────────────────────────────────────────────
NTP_URL=http://ntp:8001
SPEED_MULTIPLIER=60
SIM_START=2024-06-10T08:00:00Z

# ── News Website ───────────────────────────────────────
NEWS_URL=http://news-website:8003
DB_PATH=/data/news.db

# ── Chroma DB ─────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_PERSIST_DIR=/data/chroma

# ── Journalist Agent ───────────────────────────────────
JOURNALIST_MODEL=gemini-1.5-flash
JOURNALIST_TEMPERATURE=0.2
JOURNALIST_MAX_STEPS=12

# ── Regulator Agent (not built yet) ───────────────────
# REGULATOR_MODEL=gemini-1.5-flash
# REGULATOR_TEMPERATURE=0.1
# REGULATOR_MAX_STEPS=10

# ── Other teams' systems (black box) ──────────────────
EMAIL_URL=http://email:8010
SOCIAL_URL=http://social-network:8005
COMPANY_WEBSITE_URL=http://company-website:8004

# ── CRM (skipped for now) ─────────────────────────────
